---
interface Props {
  title: string;
  description: string;
  points?: string[];
  icon?: 'strategy' | 'implementation' | 'mlops' | 'it' | 'staffing';
}
const { title, description, points = [] } = Astro.props;
---

<div
  class="flex h-full flex-col rounded-2xl border border-border bg-bg-raised p-6 shadow-[var(--shadow-card)]"
>
  <h3 class="text-lg font-semibold text-text">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-text-muted">{description}</p>
  {
    points.length > 0 && (
      <ul class="mt-4 flex flex-col gap-2">
        {points.map((point) => (
          <li class="flex items-start gap-2 text-sm text-text-muted">
            <svg
              class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path d="M5 13l4 4L19 7" />
            </svg>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    )
  }
</div>
