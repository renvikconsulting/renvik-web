---
interface Props {
  title: string;
  description: string;
  points?: string[];
  index?: number;
  class?: string;
}
const { title, description, points = [], index, class: className = '' } = Astro.props;
---

<div class:list={['gradient-ring h-full rounded-2xl', className]}>
  <div class="glass glow-hover flex h-full flex-col rounded-2xl p-6">
    {
      typeof index === 'number' && (
        <span class="font-mono text-xs text-text-muted">{String(index + 1).padStart(2, '0')}</span>
      )
    }
    <h3 class="mt-3 font-display text-lg font-semibold text-text">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-text-muted">{description}</p>
    {
      points.length > 0 && (
        <ul class="mt-4 flex flex-col gap-2">
          {points.map((point) => (
            <li class="flex items-start gap-2 text-sm text-text-muted">
              <svg
                class="mt-0.5 h-4 w-4 flex-shrink-0 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M5 13l4 4L19 7" />
              </svg>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
