---
import Container from './Container.astro';

const year = new Date().getFullYear();
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="relative border-t border-border">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px [background-image:var(--gradient-brand)] opacity-60"></div>

  <Container class="grid gap-8 py-12 md:grid-cols-3">
    <div>
      <img src="/logo-wide.png" alt="Renvik Consulting" class="h-8 w-auto" width="1200" height="373" />
      <p class="mt-3 max-w-xs text-sm text-text-muted">
        AI strategy and implementation for teams that want AI to ship, not just pilot &mdash;
        backed by over a decade of enterprise IT delivery.
      </p>
    </div>

    <div class="flex flex-col gap-2">
      <p class="font-mono text-xs uppercase tracking-wide text-text-muted">Site</p>
      {
        links.map((link) => (
          <a href={link.href} class="text-sm text-text-muted hover:text-text">
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex flex-col gap-2">
      <p class="font-mono text-xs uppercase tracking-wide text-text-muted">Get in touch</p>
      <a href="/contact" class="text-sm text-text-muted hover:text-text">Contact form</a>
    </div>
  </Container>

  <Container class="border-t border-border py-6">
    <p class="text-xs text-text-muted">&copy; {year} Renvik Consulting. All rights reserved.</p>
  </Container>
</footer>
