---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-3 py-1 font-mono text-xs tracking-wide text-text-muted',
    className,
  ]}
>
  <span class="h-1.5 w-1.5 rounded-full [background-image:var(--gradient-brand)]"></span>
  <slot />
</span>
