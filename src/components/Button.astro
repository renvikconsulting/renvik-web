---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}
const { href, variant = 'primary', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center rounded-lg px-6 py-3 text-sm font-semibold transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2';
const variants = {
  primary: 'bg-brand text-white hover:bg-brand-hover',
  secondary:
    'border border-border text-text hover:border-brand hover:text-brand',
};
---

<a href={href} class:list={[base, variants[variant], className]}>
  <slot />
</a>
