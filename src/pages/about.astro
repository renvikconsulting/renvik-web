---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';

const values = [
  { title: 'Excellence', copy: 'We hold our own work to the standard we would want from a vendor.' },
  { title: 'Integrity', copy: 'We tell clients when AI is not the right answer, even when it costs us the engagement.' },
  { title: 'Collaboration', copy: 'We work inside your team’s existing tools and processes, not around them.' },
  { title: 'Innovation', copy: 'We stay current on the AI landscape so you do not have to track it yourself.' },
  { title: 'Inclusivity', copy: 'We build systems and teams that reflect the range of people who will use them.' },
];
---

<BaseLayout
  title="About"
  description="Renvik Consulting pairs over a decade of enterprise IT delivery experience with a practical, ROI-first approach to AI strategy and implementation."
>
  <section class="py-16 lg:py-24">
    <Container class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">About Us</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-text sm:text-5xl">Reimagine with us</h1>
      <p class="mt-6 text-lg text-text-muted">
        Renvik Consulting specializes in AI strategy and implementation, IT consulting, and technical staffing.
        We pair over a decade of enterprise IT delivery experience with a practical, ROI-first approach to
        helping organizations adopt AI &mdash; and we bring the staffing bench to execute on it.
      </p>

      <div class="mt-16 grid gap-10 sm:grid-cols-2">
        <div>
          <h2 class="text-xl font-semibold text-text">Mission</h2>
          <p class="mt-3 text-text-muted">
            To help organizations adopt AI responsibly and effectively, pairing deep technical expertise
            with pragmatic delivery &mdash; so AI projects ship instead of stalling in pilot.
          </p>
        </div>
        <div>
          <h2 class="text-xl font-semibold text-text">Vision</h2>
          <p class="mt-3 text-text-muted">
            To be the trusted AI and technology partner for organizations navigating the shift toward
            AI-native operations, recognized for expertise and real-world impact.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <section class="border-t border-border bg-bg-raised py-16 lg:py-24">
    <Container>
      <SectionHeading eyebrow="What guides us" title="Our values" align="left" />
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          values.map((value) => (
            <div>
              <h3 class="font-semibold text-text">{value.title}</h3>
              <p class="mt-2 text-sm text-text-muted">{value.copy}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!--
    TODO(content): add a team section once real bios/photos are available.
    Intentionally omitted rather than filled with placeholder people - see
    CLAUDE.md#content-honesty.
  -->
</BaseLayout>
