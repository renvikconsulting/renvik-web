---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';

const services = [
  {
    title: 'AI Strategy & Advisory',
    description:
      'A practical, ROI-first roadmap: where AI fits in your business, which use cases to prioritize, and how to sequence the work.',
    span: 'lg:col-span-3',
  },
  {
    title: 'AI & LLM Implementation',
    description:
      'RAG systems, internal copilots, and agentic workflows, integrated into the systems your team already uses.',
    span: 'lg:col-span-3',
  },
  {
    title: 'MLOps & Data Platforms',
    description:
      'Data pipelines, model deployment, and observability so AI systems stay reliable and cost-effective in production.',
    span: 'lg:col-span-2',
  },
  {
    title: 'IT Consulting',
    description:
      'Technology assessments, systems architecture, and cloud infrastructure guidance grounded in over a decade of delivery.',
    span: 'lg:col-span-2',
  },
  {
    title: 'Technical Staffing',
    description:
      'Staff augmentation and permanent placement for AI/ML and software engineering roles when you need to move faster than you can hire.',
    span: 'lg:col-span-2',
  },
];

const approach = [
  { step: '01', title: 'Discover', copy: 'Assess your data, systems, and workflows to find where AI creates real leverage.' },
  { step: '02', title: 'Design', copy: 'Scope a solution and a delivery plan sized to the problem, not the hype.' },
  { step: '03', title: 'Build', copy: 'Implement, integrate, and test against your actual production constraints.' },
  { step: '04', title: 'Operate', copy: 'Monitor, tune, and hand off with the documentation your team needs to own it.' },
];
---

<BaseLayout
  title="AI Consulting & Implementation"
  description="Renvik Consulting helps teams design, build, and operationalize AI systems - from strategy through production - backed by over a decade of enterprise IT delivery."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="blob h-[420px] w-[420px] -left-40 -top-32 bg-brand"></div>
    <div class="blob blob-alt h-[380px] w-[380px] -right-32 top-10 bg-accent"></div>

    <Container class="relative py-20 lg:py-32">
      <div class="mx-auto max-w-3xl text-center">
        <Eyebrow class="mx-auto">AI Strategy &middot; Implementation &middot; MLOps</Eyebrow>
        <h1 class="mt-6 font-display text-5xl font-bold tracking-tight text-text sm:text-6xl lg:text-7xl">
          AI consulting that <span class="text-gradient">ships</span>, not just slides.
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-text-muted">
          We help mid-market and enterprise teams design, build, and operationalize AI systems &mdash;
          from strategy through production &mdash; backed by over a decade of enterprise IT delivery.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-4">
          <Button href="/contact" variant="primary">Book a Consultation</Button>
          <Button href="/services" variant="secondary">Explore Services</Button>
        </div>
      </div>

      <div class="gradient-ring mx-auto mt-16 max-w-4xl rounded-2xl">
        <img
          src="/it_consult.jpg"
          alt="Renvik consultants working through a technology roadmap"
          class="aspect-[16/9] w-full rounded-2xl object-cover"
          width="1024"
          height="576"
        />
      </div>
    </Container>
  </section>

  <!-- Services overview: bento grid -->
  <section class="relative py-16 lg:py-24">
    <Container>
      <SectionHeading
        eyebrow="What we do"
        title="Five ways we help you put AI to work"
        description="Each engagement starts with your business problem, not a technology looking for a use case."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-6">
        {
          services.map((service, i) => (
            <ServiceCard title={service.title} description={service.description} index={i} class={service.span} />
          ))
        }
      </div>
      <div class="mt-10">
        <Button href="/services" variant="secondary">View all services</Button>
      </div>
    </Container>
  </section>

  <!-- Approach -->
  <section class="relative border-t border-border py-16 lg:py-24">
    <Container>
      <SectionHeading eyebrow="How we work" title="A delivery process built for production, not pilots" />
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          approach.map((item) => (
            <div>
              <p class="font-mono text-3xl font-bold text-gradient">{item.step}</p>
              <h3 class="mt-2 font-display font-semibold text-text">{item.title}</h3>
              <p class="mt-2 text-sm text-text-muted">{item.copy}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!--
    TODO(content): once real client engagements can be named publicly, add a
    proof section here (logos / case studies / metrics). Intentionally
    omitted for now rather than filled with placeholder claims - see
    CLAUDE.md#content-honesty.
  -->

  <!-- CTA -->
  <section class="relative overflow-hidden py-16 lg:py-24">
    <Container>
      <div class="relative overflow-hidden rounded-3xl px-8 py-16 text-center [background-image:var(--gradient-brand)]">
        <div class="blob h-[300px] w-[300px] left-1/4 top-0 bg-white/40"></div>
        <h2 class="relative font-display text-3xl font-bold text-white sm:text-4xl">
          Ready to see where AI fits in your roadmap?
        </h2>
        <p class="relative mx-auto mt-4 max-w-xl text-white/85">
          Book a short consultation and we'll help you find the highest-leverage place to start.
        </p>
        <div class="relative mt-8">
          <a
            href="/contact"
            class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-[#1a0b3d] transition-transform hover:-translate-y-0.5"
          >
            Book a Consultation
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
