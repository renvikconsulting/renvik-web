---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';

const services = [
  {
    title: 'AI Strategy & Advisory',
    description:
      'A practical, ROI-first roadmap: where AI fits in your business, which use cases to prioritize, and how to sequence the work.',
  },
  {
    title: 'AI & LLM Implementation',
    description:
      'RAG systems, internal copilots, and agentic workflows, integrated into the systems your team already uses.',
  },
  {
    title: 'MLOps & Data Platforms',
    description:
      'Data pipelines, model deployment, and observability so AI systems stay reliable, monitored, and cost-effective in production.',
  },
  {
    title: 'IT Consulting',
    description:
      'Technology assessments, systems architecture, and cloud infrastructure guidance grounded in over a decade of delivery.',
  },
  {
    title: 'Technical Staffing',
    description:
      'Staff augmentation and permanent placement for AI/ML and software engineering roles when you need to move faster than you can hire.',
  },
];

const approach = [
  { step: '01', title: 'Discover', copy: 'Assess your data, systems, and workflows to find where AI creates real leverage.' },
  { step: '02', title: 'Design', copy: 'Scope a solution and a delivery plan sized to the problem, not the hype.' },
  { step: '03', title: 'Build', copy: 'Implement, integrate, and test against your actual production constraints.' },
  { step: '04', title: 'Operate', copy: 'Monitor, tune, and hand off with the documentation your team needs to own it.' },
];
---

<BaseLayout
  title="AI Consulting & Implementation"
  description="Renvik Consulting helps teams design, build, and operationalize AI systems - from strategy through production - backed by over a decade of enterprise IT delivery."
>
  <!-- Hero -->
  <section class="overflow-hidden">
    <Container class="grid items-center gap-12 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-brand">AI Consulting & Implementation</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-text sm:text-5xl">
          AI consulting that ships, not just slides.
        </h1>
        <p class="mt-6 text-lg text-text-muted">
          We help mid-market and enterprise teams design, build, and operationalize AI systems &mdash;
          from strategy through production &mdash; backed by over a decade of enterprise IT delivery.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href="/contact" variant="primary">Book a Consultation</Button>
          <Button href="/services" variant="secondary">Explore Services</Button>
        </div>
      </div>
      <div class="relative">
        <img
          src="/it_consult.jpg"
          alt="Renvik consultants working through a technology roadmap"
          class="aspect-[4/3] w-full rounded-2xl object-cover shadow-[var(--shadow-card)]"
          width="640"
          height="480"
        />
      </div>
    </Container>
  </section>

  <!-- Services overview -->
  <section class="py-16 lg:py-24">
    <Container>
      <SectionHeading
        eyebrow="What we do"
        title="Five ways we help you put AI to work"
        description="Each engagement starts with your business problem, not a technology looking for a use case."
      />
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => <ServiceCard {...service} />)}
      </div>
      <div class="mt-10">
        <Button href="/services" variant="secondary">View all services</Button>
      </div>
    </Container>
  </section>

  <!-- Approach -->
  <section class="border-t border-border bg-bg-raised py-16 lg:py-24">
    <Container>
      <SectionHeading eyebrow="How we work" title="A delivery process built for production, not pilots" />
      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          approach.map((item) => (
            <div>
              <p class="text-3xl font-bold text-brand">{item.step}</p>
              <h3 class="mt-2 font-semibold text-text">{item.title}</h3>
              <p class="mt-2 text-sm text-text-muted">{item.copy}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!--
    TODO(content): once real client engagements can be named publicly, add a
    proof section here (logos / case studies / metrics). Intentionally
    omitted for now rather than filled with placeholder claims - see
    CLAUDE.md#content-honesty.
  -->

  <!-- CTA -->
  <section class="py-16 lg:py-24">
    <Container class="rounded-2xl bg-brand px-8 py-16 text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">Ready to see where AI fits in your roadmap?</h2>
      <p class="mx-auto mt-4 max-w-xl text-white/80">
        Book a short consultation and we'll help you find the highest-leverage place to start.
      </p>
      <div class="mt-8">
        <a
          href="/contact"
          class="inline-flex items-center justify-center rounded-lg bg-white px-6 py-3 text-sm font-semibold text-brand transition-colors hover:bg-white/90"
        >
          Book a Consultation
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
