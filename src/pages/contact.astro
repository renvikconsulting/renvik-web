---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';

// Public Turnstile site key (safe to expose - the secret key lives only in
// the Pages Function env, never here). Must be set at build time; see
// docs/DEPLOYMENT.md#turnstile.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';

// Real contact details, confirmed via PR review (see PR #1 review
// comments). Values are base64'd below and assembled client-side; see
// docs/SECURITY.md#contact-detail-obfuscation.
const contactEmail = 'info@renvikconsulting.com';
const contactPhone = '+1 (469) 712 7575';
const contactAddress = 'Frisco, TX 75036';
const emailEncoded = Buffer.from(contactEmail).toString('base64');
const phoneEncoded = Buffer.from(contactPhone).toString('base64');
---

<BaseLayout
  title="Contact"
  description="Book a consultation with Renvik Consulting to discuss AI strategy, implementation, IT consulting, or technical staffing."
>
  <section class="relative overflow-hidden py-16 lg:py-24">
    <div class="blob h-[380px] w-[380px] -left-40 top-0 bg-accent"></div>

    <Container class="relative grid gap-16 lg:grid-cols-2">
      <div>
        <Eyebrow>Contact Us</Eyebrow>
        <h1 class="mt-6 font-display text-4xl font-bold tracking-tight text-text sm:text-5xl">Get in touch</h1>
        <p class="mt-6 text-lg text-text-muted">
          Have a project in mind, or just want to talk through where AI might fit? Send us a message and
          we'll get back to you.
        </p>

        <dl class="mt-10 flex flex-col gap-6">
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-text-muted">Phone</dt>
            <dd class="mt-1 text-text">
              <a id="contact-phone-link" href="#" class="hover:text-brand" data-b64={phoneEncoded}>
                <span id="contact-phone-text">Loading&hellip;</span>
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-text-muted">Email</dt>
            <dd class="mt-1 text-text">
              <a id="contact-email-link" href="#" class="hover:text-brand" data-b64={emailEncoded}>
                <span id="contact-email-text">Loading&hellip;</span>
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-mono text-xs uppercase tracking-wide text-text-muted">Address</dt>
            <dd class="mt-1 text-text">{contactAddress}</dd>
          </div>
        </dl>
      </div>

      <div class="gradient-ring rounded-2xl">
        <div class="glass rounded-2xl p-6 sm:p-8">
          <!--
            Native constraint validation (required / type=email / maxlength)
            blocks empty or malformed submissions before the JS handler runs;
            the server re-validates the same rules (functions/api/contact.ts)
            and the maxlengths below mirror its caps.
          -->
          <form id="contact-form" class="flex flex-col gap-5">
            <div class="flex flex-col gap-1.5">
              <label for="name" class="text-sm font-medium text-text">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                maxlength="200"
                autocomplete="name"
                class="rounded-lg border border-border bg-bg px-3 py-2 text-text placeholder:text-text-muted/60 focus-visible:border-brand"
                placeholder="Your name"
              />
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="email" class="text-sm font-medium text-text">Email</label>
              <!--
                type="email" alone is the browser's lax check (it accepts
                user@domain with no TLD dot); pattern mirrors the server's
                EMAIL_RE in functions/api/contact.ts (dot-separated domain
                labels + a 2+ letter TLD), so a missing dot after the @ - or
                a malformed label - is flagged before submit. The
                #email-error line below is driven by the same validity check
                while typing (see updateEmailError in the script) and stays
                visible until the value is fixed.
              -->
              <input
                id="email"
                name="email"
                type="email"
                required
                maxlength="254"
                pattern="[A-Za-z0-9._%+-]+@(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,}"
                autocomplete="email"
                class="rounded-lg border border-border bg-bg px-3 py-2 text-text placeholder:text-text-muted/60 focus-visible:border-brand"
                placeholder="you@company.com"
              />
              <p id="email-error" class="text-xs text-red-500" aria-live="polite" hidden></p>
            </div>

            <div class="flex flex-col gap-1.5">
              <label for="message" class="text-sm font-medium text-text">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                maxlength="5000"
                class="rounded-lg border border-border bg-bg px-3 py-2 text-text placeholder:text-text-muted/60 focus-visible:border-brand"
                placeholder="Tell us a bit about what you're working on"
              ></textarea>
            </div>

            <!--
              Honeypot: real users never see or fill this in (visually hidden,
              not display:none - some bots skip display:none fields). Any
              non-empty value here is treated as spam server-side. See
              functions/api/contact.ts.
            -->
            <div class="visually-hidden" aria-hidden="true">
              <label for="website">Leave this field empty</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            {
              turnstileSiteKey && (
                <div
                  id="contact-turnstile"
                  class="cf-turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-action="contact"
                  data-theme="auto"
                />
              )
            }

            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-white shadow-[var(--shadow-glow)] transition-all hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60 [background-image:var(--gradient-brand)]"
            >
              Send Message
            </button>

            <p id="form-status" role="status" class="text-sm" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </Container>
  </section>

</BaseLayout>

<script>
  // Assembled client-side from a data-b64 attribute (not inlined into the
  // script itself) so plain-text scrapers of the HTML source don't pick up
  // a bare mailto:/tel: string, and so this script stays a normal bundled
  // file covered by CSP's `script-src 'self'` - no hash to maintain here,
  // unlike the pre-paint theme script in BaseLayout.astro. See
  // docs/SECURITY.md#contact-detail-obfuscation.
  function decodeContactLink(linkId: string, textId: string, hrefPrefix: string, clean?: (s: string) => string) {
    const link = document.getElementById(linkId);
    const text = document.getElementById(textId);
    const encoded = link?.dataset.b64;
    if (!link || !text || !encoded) return;
    const value = atob(encoded);
    link.setAttribute('href', hrefPrefix + (clean ? clean(value) : value));
    text.textContent = value;
  }

  decodeContactLink('contact-email-link', 'contact-email-text', 'mailto:');
  decodeContactLink('contact-phone-link', 'contact-phone-text', 'tel:', (s) => s.replace(/[^+\d]/g, ''));
</script>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const submitButton = document.querySelector<HTMLButtonElement>('button[type="submit"]');

  // Turnstile (explicit render): the widget div above only exists when
  // PUBLIC_TURNSTILE_SITE_KEY was set at build time, so when it's missing
  // this is a no-op and the api.js script is never requested. Tokens are
  // single-use: after every same-page submission attempt the widget is
  // reset (with the retained widget id) so a retry gets a fresh token -
  // resubmitting a redeemed token would always fail siteverify. If the
  // script or widget can't run on this client (blocked, errored),
  // turnstileUnavailable below is set and the submission goes through
  // WITHOUT a token - the Function skips siteverify for missing tokens,
  // so the form keeps working where Turnstile can't (see docs/SECURITY.md).
  type TurnstileApi = {
    render: (
      container: HTMLElement,
      options: {
        sitekey: string;
        action: string;
        theme?: 'light' | 'dark' | 'auto';
        // Fires the moment the user ticks the checkbox, before the challenge
        // has been verified - unlocks the button without waiting for the token.
        'before-callback'?: () => void;
        callback?: (token: string) => void;
        'error-callback'?: (errorCode: string) => void;
        // Fires when a generated token expires before it's used.
        'expire-callback'?: () => void;
      },
    ) => string;
    reset: (widgetId: string) => void;
  };
  const turnstileWindow = window as Window & { turnstile?: TurnstileApi };
  const turnstileContainer = document.getElementById('contact-turnstile');
  let contactWidgetId: string | undefined;
  // Explicit rendering does NOT auto-add a cf-turnstile-response input to
  // the form (that only happens with implicit rendering) - the token arrives
  // exclusively via this callback, so the payload below reads it from here
  // rather than from FormData.
  let contactToken = '';
  // Guards the button while a submission request is in flight so keystrokes
  // can't re-enable it mid-flight.
  let submitting = false;
  // Woken by the token callback (or a challenge error/expire) so a submit
  // that lands while verification is in flight can continue instead of
  // bouncing the user.
  let tokenWaiter: (() => void) | null = null;
  // Set when the Turnstile script fails to load (ad blocker, strict CSP, or
  // regional/network block on challenges.cloudflare.com) or the widget
  // reports an error: the client can't produce a token, so a submission
  // proceeds WITHOUT one instead of waiting for a token that can't come.
  // The Function skips siteverify for a missing token (the honeypot and the
  // Cloudflare edge rate-limit rule remain the spam backstop).
  let turnstileUnavailable = false;

  // The submit button unlocks exactly when every field passes the browser's
  // constraint validation (required / type=email / pattern / maxlength),
  // re-evaluated on every keystroke. Deliberately NOT gated on the challenge
  // state: in practice Turnstile's before-callback doesn't reliably fire at
  // the moment the box is ticked, so waiting for it kept the button locked
  // for the whole verification. The token is still enforced in the submit
  // handler (and server-side) whenever the widget can run: a Send click
  // before/while the challenge runs waits for the token and then proceeds.
  // Only when the client can't run the widget at all does a submission go
  // through without a token.
  const updateSubmitButton = () => {
    if (submitting || !submitButton || !(form instanceof HTMLFormElement)) return;
    submitButton.disabled = !form.checkValidity();
  };

  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const emailError = document.getElementById('email-error') as HTMLParagraphElement | null;

  // Inline email feedback: while the field holds text that isn't a valid
  // email, the message under the input stays visible; the moment the value
  // becomes valid (or is emptied) it disappears. An empty field is left to
  // the required check on submit - nagging about emptiness before the user
  // has started typing isn't useful.
  const updateEmailError = () => {
    if (!emailInput || !emailError) return;
    const invalid = emailInput.value !== '' && !emailInput.checkValidity();
    emailError.textContent = invalid
      ? emailInput.validationMessage || 'Please enter a valid email address.'
      : '';
    emailError.hidden = !invalid;
  };

  // Client-side mirror of the sanitization in functions/api/contact.ts (the
  // server remains the authority): strip C0 control characters to block
  // CRLF-based header injection into the outgoing email's Subject:/From:
  // lines, and < > from the name, which is spliced into the
  // `From: ${name} <${email}>` line. Newlines are kept in the message body.
  const sanitizeName = (value: string) => value.replace(/[\u0000-\u001f\u007f<>]/g, '').trim();
  const sanitizeEmail = (value: string) => value.replace(/[\u0000-\u001f\u007f]/g, '').trim();
  const sanitizeMessage = (value: string) =>
    value.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f\r]/g, '').trim();

  // The button and the inline email error start from their computed state,
  // and the 'input' listener keeps both in step with the fields as they
  // change: the button unlocks the moment the fields validate (AND, with a
  // widget, the challenge is ticked); the email error shows while the value
  // is non-empty and invalid, and clears the moment it's fixed.
  updateSubmitButton();
  updateEmailError();
  form?.addEventListener('input', () => {
    updateSubmitButton();
    updateEmailError();
  });

  const renderContactTurnstile = () => {
    if (!turnstileWindow.turnstile || !turnstileContainer) return;
    contactWidgetId = turnstileWindow.turnstile.render(turnstileContainer, {
      sitekey: turnstileContainer.dataset.sitekey!,
      action: 'contact',
      theme: 'auto',
      callback: (token) => {
        contactToken = token;
        if (tokenWaiter) {
          const waiter = tokenWaiter;
          tokenWaiter = null;
          waiter();
        }
        updateSubmitButton();
      },
      'expire-callback': () => {
        // A generated token lapsed before use - force a fresh tick.
        contactToken = '';
        if (tokenWaiter) {
          const waiter = tokenWaiter;
          tokenWaiter = null;
          waiter();
        }
        updateSubmitButton();
      },
      'error-callback': (errorCode) => {
        // The widget failed (e.g. this hostname isn't registered for the
        // widget) - verification is impossible from this client, so a submit
        // attempt proceeds without a token (the server skips siteverify)
        // instead of timing out with an error.
        console.warn('Turnstile failed to load:', errorCode);
        turnstileUnavailable = true;
        contactToken = '';
        if (tokenWaiter) {
          const waiter = tokenWaiter;
          tokenWaiter = null;
          waiter();
        }
        updateSubmitButton();
      },
    });
  };

  if (turnstileContainer) {
    if (turnstileWindow.turnstile) {
      renderContactTurnstile();
    } else {
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.addEventListener('load', renderContactTurnstile, { once: true });
      // Blocked or unreachable (ad blocker, strict CSP, regional block):
      // the widget can never render, so mark Turnstile unavailable and let
      // submissions proceed without a token.
      script.addEventListener(
        'error',
        () => {
          console.warn('Turnstile script failed to load');
          turnstileUnavailable = true;
          if (tokenWaiter) {
            const waiter = tokenWaiter;
            tokenWaiter = null;
            waiter();
          }
          updateSubmitButton();
        },
        { once: true },
      );
      document.head.appendChild(script);
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement) || !status) return;
    // A submission (or its verification wait) is already in flight.
    if (submitting) return;

    // No token yet: either the checkbox hasn't been ticked, or it was just
    // ticked and verification is in flight (Turnstile's callbacks can't
    // tell us which). Instead of rejecting the click, wait for the token
    // and continue - the status text guides a user who hasn't ticked yet,
    // and ticking the box while we wait completes this wait and sends the
    // form without a second click.
    if (turnstileContainer && !contactToken && !turnstileUnavailable) {
      submitting = true;
      if (submitButton) submitButton.disabled = true;
      status.textContent =
        "Verifying… please tick the Turnstile checkbox if it isn't ticked yet.";
      status.className = 'text-sm text-text-muted';
      const outcome = await new Promise<'token' | 'timeout'>((resolve) => {
        let settled = false;
        const settle = (result: 'token' | 'timeout') => {
          if (settled) return;
          settled = true;
          if (tokenWaiter === waiter) tokenWaiter = null;
          resolve(result);
        };
        const waiter = () => settle('token');
        tokenWaiter = waiter;
        setTimeout(() => settle('timeout'), 15000);
      });
      if (outcome === 'timeout' || !contactToken) {
        if (turnstileUnavailable || !turnstileWindow.turnstile) {
          // Turnstile became unavailable while we waited (widget error, or
          // the api.js load hung without firing load/error) - the challenge
          // can never complete on this client, so send without a token; the
          // server skips verification when the token is missing.
          // (fall through to the POST below)
        } else {
          // No usable token and the widget is working - reset the challenge
          // for a fresh tick.
          submitting = false;
          contactToken = '';
          if (contactWidgetId !== undefined) turnstileWindow.turnstile?.reset(contactWidgetId);
          updateSubmitButton();
          status.textContent = 'Verification did not complete - please tick the checkbox and try again.';
          status.className = 'text-sm text-red-500';
          return;
        }
      }
      // Token arrived while we waited (or we're degrading to an unverified
      // send) - fall through and submit.
    }

    const formData = new FormData(form);
    const payload = {
      name: sanitizeName(String(formData.get('name') ?? '')),
      email: sanitizeEmail(String(formData.get('email') ?? '')),
      message: sanitizeMessage(String(formData.get('message') ?? '')),
      website: String(formData.get('website') ?? ''), // honeypot
      turnstileToken: contactToken,
    };

    submitting = true;
    if (submitButton) submitButton.disabled = true;
    status.textContent = 'Sending…';
    status.className = 'text-sm text-text-muted';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!res.ok) {
        // Surface the server's specific error (e.g. "Please provide a valid
        // email address.") when the response has one; fall back to the
        // generic message for non-JSON/unknown failures.
        let detail = '';
        try {
          const body = (await res.json()) as { error?: string };
          if (body && typeof body.error === 'string') detail = body.error;
        } catch {
          // non-JSON error body - keep the generic message
        }
        throw new Error(detail);
      }

      status.textContent = "Thanks - we'll be in touch shortly.";
      status.className = 'text-sm text-emerald-500';
      form.reset();
    } catch (err) {
      const detail = err instanceof Error && err.message ? err.message : '';
      status.textContent =
        detail || 'Something went wrong sending your message. Please try emailing us directly.';
      status.className = 'text-sm text-red-500';
    } finally {
      if (contactWidgetId !== undefined) turnstileWindow.turnstile?.reset(contactWidgetId);
      // The token was just consumed (or will be on the next attempt) - clear
      // it so a too-early resubmit can't send a redeemed token. The widget
      // reset above re-arms a fresh challenge; the next Send will wait for
      // the new tick's token.
      submitting = false;
      contactToken = '';
      updateSubmitButton();
    }
  });
</script>
